# Секрет сессий Flask — ОБЯЗАТЕЛЬНО смените в продакшене
SECRET_KEY=change-me-please

# База данных. По умолчанию SQLite рядом с приложением.
# Для продакшена рекомендую PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/teplodom
# DATABASE_URL=sqlite:///teplodom.db

# Токен для публичного вебхука /webhooks/lead (Instagram/TikTok-агрегаторы)
WEBHOOK_TOKEN=change-me-webhook-token

# Автопилот заявок: 1 — автозаполнять пустые поля из текста и назначать
# менеджера, 0 — выключить. AUTOPILOT_TASK=0 — не создавать задачу «Позвонить»
AUTOPILOT=1
AUTOPILOT_TASK=1

# --- amoCRM (amoCRM → Настройки → Настройки → API) ---
AMOCRM_URL=https://yourcompany.amocrm.ru
AMOCRM_KEY=your-api-key
AMOCRM_SECRET=your-api-secret
AMOCRM_PIPELINE_ID=1

# --- 1С (REST Web Services, настроенный в 1С) ---
ONES_URL=https://server/bs/teplodom
ONES_USER=user
ONES_PASS=pass
ONES_CATALOG_PATH=/rest/tp/v2/nomenklatura
ONES_STOCKS_PATH=/rest/tp/v2/ozh
ONES_DOC_PATH=/rest/tp/v2/schet-klientu
